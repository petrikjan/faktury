{
  "name": "faktury",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "concurrently -k \"node --import tsx --watch apps/api/src/main.ts\" \"vite --config apps/web/vite.config.ts\"",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts && tsup apps/api/src/main.ts --format esm --target node26 --out-dir dist/api --sourcemap",
    "start": "node --env-file=.env dist/api/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:deploy && npm run build",
    "db:migrate": "node --import tsx scripts/db.ts migrate",
    "db:check": "node --import tsx scripts/db.ts check",
    "db:seed": "node --import tsx scripts/db.ts seed",
    "admin:create": "node --import tsx scripts/db.ts admin",
    "migration:preflight": "node --import tsx scripts/migration/cli.ts preflight",
    "migration:dry-run": "node --import tsx scripts/migration/cli.ts dry-run",
    "migration:import": "node --import tsx scripts/migration/cli.ts import",
    "migration:verify": "node --import tsx scripts/migration/cli.ts verify",
    "pdf:compare": "node --import tsx scripts/pdf-compare.ts",
    "backup": "node --import tsx scripts/backup.ts",
    "start:production": "node scripts/start-production.mjs",
    "test:deploy": "python3 -m unittest discover -s tests -p \"test_deploy.py\"",
    "migration:archive": "node --import tsx scripts/migration/archive-source.ts",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "security:scan": "node scripts/security-scan.mjs",
    "verify:clean": "node scripts/verify-clean.mjs",
    "test:pdf": "node --import tsx scripts/pdf-matrix.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@modelcontextprotocol/sdk": "1.32.2",
    "argon2": "0.45.2",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.9",
    "ejs": "7.0.2",
    "fastify": "5.12.8",
    "jose": "6.2.15",
    "lucide-react": "1.69.0",
    "mysql2": "3.24.6",
    "playwright": "1.64.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/ejs": "3.1.5",
    "@types/node": "26.6.6",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsqr": "1.4.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
